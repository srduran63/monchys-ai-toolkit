{
  "name": "monchys-ia",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web -c red,yellow \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --env-file-if-exists=.env --watch server/index.js",
    "dev:web": "vite",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server/index.js",
    "set-password": "node server/set-password.js",
    "videos": "node video/render.mjs",
    "db:migrate": "node --env-file-if-exists=.env supabase/migrate.mjs",
    "apple-secret": "node supabase/apple-secret.mjs",
    "videos:vertical": "node video/vertical.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@huggingface/transformers": "^4.3.1",
    "@supabase/supabase-js": "^2.118.0",
    "cookie-parser": "^1.4.7",
    "docx": "^9.14.0",
    "express": "^5.3.0",
    "fflate": "^0.8.3",
    "ffmpeg-static": "^5.3.0",
    "heic-convert": "^2.1.0",
    "lucide-react": "^1.61.0",
    "multer": "^2.5.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.7.284",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5",
    "stripe": "^23.0.1",
    "unpdf": "^1.9.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "puppeteer-core": "^23.11.1",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.5"
  },
  "allowScripts": {
    "ffmpeg-static@5.3.0": true,
    "onnxruntime-node@1.30.0": true,
    "protobufjs@7.6.6": true
  }
}
